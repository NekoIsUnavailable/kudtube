{
  "name": "kudtube",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "package": "npm run build && electron-builder -w -c.mac.identity=null",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "cap:sync": "npm run build && cap sync android",
    "cap:build:android": "npm run build && cap sync android && cd android && gradlew assembleDebug"
  },
  "build": {
    "appId": "com.kudtube.app",
    "productName": "KudTube",
    "directories": {
      "output": "../release_kudtube"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KudTube"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!electron/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "icons",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "electron/bin/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
